# ===== Video Foundry 环境变量模板 =====
# 复制为 .env 并按需修改。生产环境务必改掉所有默认密钥/密码。

# --- 数据库 ---
# 开发：SQLite；生产：PostgreSQL
DATABASE_URL=sqlite:///backend/data/backend.db

# --- 鉴权 ---
JWT_SECRET=development-only-change-me
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# --- Worker（单机：串行处理）---
WORKER_ENABLED=true
PIPELINE_WORKER_ENABLED=true
# 单机单 worker：启动时把上次进程残留的 running 任务重新入队（避免卡在「渲染中」）
PIPELINE_RESET_RUNNING_ON_START=true
PIPELINE_LEASE_SECONDS=600
# 引擎渲染帧并发（也可在「设置」页运行时覆盖）
RENDER_CONCURRENCY=1

# --- Agent（opencode headless 单模式）---
AGENT_SKILL_DIRNAME=video-shotcraft
AGENT_MODEL_CAPABILITY=text
AGENT_REVIEW_MODEL_CAPABILITY=vision
AGENT_WALL_SECONDS=3600
AGENT_RENDER_TIMEOUT_SECONDS=1800
# opencode question 工具策略：deny=拒绝提问（默认，避免无人回答空转到墙钟）；ask/wait 需平台回答入口
AGENT_QUESTION_POLICY=deny
# opencode headless：与 backend 同容器，只监听 loopback
OPENCODE_BINARY=opencode
OPENCODE_VERSION=1.18.34
OPENCODE_HOSTNAME=127.0.0.1
OPENCODE_PORT=0
OPENCODE_PROVIDER_ID=vf
# 留空=每次运行自动生成
OPENCODE_SERVER_PASSWORD=

# --- 中文配音（免费 Edge 引擎，免登录；可上传人工旁白兜底）---
TTS_ENABLED=true
TTS_PROVIDER=edge
TTS_FALLBACK=none
# 合成失败时是否阻塞渲染（false=退化为无声成片并记录）
TTS_REQUIRED=false
TTS_ENGINE=edge
TTS_VOICE_ZH=zh-CN-YunxiNeural
TTS_VOICE_EN=en-US-AndrewNeural
TTS_RATE=+0%
# edge-tts 每句重试次数（网络间歇性失败时调高）与代理（不自动读系统代理）
TTS_RETRIES=8
TTS_PROXY=
# 强制 IPv4 连接（双栈机器常随机选到不可达的 IPv6；默认开启）
TTS_FORCE_IPV4=true
TTS_LEAD_FRAMES=12
TTS_GAP_FRAMES=12
TTS_CHAPTER_GAP_FRAMES=30
TTS_TAIL_FRAMES=45

# --- AI 主题封面（OpenAI 兼容 /images/generations）---
# 关掉后即使项目选了图片模型也不自动生成封面；模型在「设置 → 模型」里 capability 选 image。
COVER_ENABLED=true
COVER_TIMEOUT_SECONDS=180

# --- 运维 ---
# 可再生产物保留天数（引擎工程 / 成片 / TTS 缓存）
# CLEANUP_RETENTION_DAYS=14

# --- AI（OpenAI 兼容；也可在网站「AI 供应商」页配置，此处仅作后备默认）---
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_ALLOW_LOCAL_HTTP=false

# --- 目录 ---
# 引擎目录（只挂载 video-shotcraft）
ENGINES_DIR=engines
PROJECTS_DIR=data/projects
