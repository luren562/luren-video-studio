# 后端本地开发环境变量（复制为 backend/.env）
APP_NAME=Video Foundry Backend
# 留空则默认 sqlite:///<backend>/data/backend.db（绝对路径）
# DATABASE_URL=
JWT_SECRET=development-only-change-me
FERNET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
CORS_ORIGINS=["http://localhost:5173"]
WORKER_ENABLED=true
PIPELINE_GENERATION_CONCURRENCY=1
PIPELINE_RENDER_CONCURRENCY=1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_ALLOW_LOCAL_HTTP=false

# 中文配音（项目级开关/音色在创建页选择；免费 Edge 引擎，免登录）
TTS_PROVIDER=edge
TTS_FALLBACK=none
TTS_ENABLED=true
TTS_REQUIRED=false
TTS_VOICE_ZH=zh-CN-YunxiNeural
TTS_VOICE_EN=en-US-AndrewNeural
TTS_RATE=+0%

# --- 视频/音频转文稿（faster-whisper 本地识别）---
TRANSCRIBE_ENABLED=true
TRANSCRIBE_MODEL=small
TRANSCRIBE_DEVICE=cpu
TRANSCRIBE_COMPUTE_TYPE=int8
TRANSCRIBE_LANGUAGE=zh
TRANSCRIBE_MAX_DOWNLOAD_MB=2048

# --- Agent 电影（完全由 agent 读 skill 写 Remotion Composition）---
# 开启后，mode=agent 的项目走 agent_film 路径；需在后台配置 capability=vision 的模型（如 MiMo）
AGENT_FILM_ENABLED=false
AGENT_SKILL_DIRNAME=video-shotcraft
AGENT_MODEL_CAPABILITY=text
AGENT_REVIEW_MODEL_CAPABILITY=vision
AGENT_MAX_ITERS=96
AGENT_MAX_VIDEO_RENDERS=3
AGENT_MAX_INSPECTIONS=4
AGENT_MAX_STILL_REVIEWS=6
AGENT_FINALIZE_RESERVE_ITERS=6
AGENT_CONTEXT_CHARS=40000
AGENT_MAX_TOOL_OUTPUT=7000
AGENT_VISION_FRAMES=6
AGENT_WALL_SECONDS=3600
AGENT_RENDER_TIMEOUT_SECONDS=1800
AGENT_TOKEN_BUDGET=1200000
AGENT_PROMPT_TOKEN_BUDGET=900000
AGENT_COMPLETION_TOKEN_BUDGET=300000

# Agent single-job frame concurrency and readiness/review sampling
AGENT_RENDER_CONCURRENCY=0
AGENT_RENDER_MIN_FREE_MB=1200
AGENT_CHECK_BUNDLE_CACHE=true
AGENT_CHECK_BUNDLE_KEEP=2
AGENT_STILL_SCALE=0.5
AGENT_SETTLE_RATIO=0.9
AGENT_SETTLE_MARGIN_FRAMES=2
AGENT_REVIEW_MOTION_FRAMES=true
